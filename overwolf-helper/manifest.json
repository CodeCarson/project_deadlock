{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "Deadlock Companion Timer Helper",
    "author": "Deadlock Companion contributors",
    "version": "0.3.1",
    "minimum-overwolf-version": "0.311.0.6",
    "description": "Background-only local match-clock relay for Deadlock Companion. No overlay or recording.",
    "dock_button_title": "Deadlock Timers",
    "icon": "icon.png",
    "icon_gray": "icon.png"
  },
  "permissions": ["GameInfo"],
  "data": {
    "start_window": "background",
    "windows": {
      "background": {
        "file": "background.html",
        "is_background_page": true,
        "background_optimization": true,
        "disable_hardware_acceleration": true
      }
    },
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [24482]
    },
    "game_events": [24482],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [24482]
        },
        "start_minimized": true
      }
    ]
  }
}

{
  "name": "deadlock-companion",
  "version": "0.2.0",
  "private": true,
  "description": "A Windows Deadlock companion with public player statistics and configurable match reminders",
  "author": "Deadlock Companion contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://127.0.0.1:5173 dist-electron/electron/main.js dist-electron/electron/preload.cjs && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc -p tsconfig.electron.json && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:ui": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "pack:linux": "npm run build && electron-builder --linux dir",
    "test:desktop": "npm run build && playwright test -c playwright.desktop.config.ts",
    "electron:install": "install-electron",
    "postinstall": "install-electron",
    "format": "prettier --write src electron tests config *.ts *.json index.html README.md",
    "format:check": "prettier --check src electron tests config *.ts *.json index.html README.md",
    "test:desktop:cloud": "bash scripts/test-desktop-cloud.sh",
    "dist:win:zip": "npm run build && electron-builder --win zip --x64"
  },
  "build": {
    "appId": "com.deadlockcompanion.desktop",
    "productName": "Deadlock Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "electron": "^44.7.0",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "app-builder-lib": {
      "@electron/get": "^5.0.0"
    }
  }
}
